<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="26000" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="tab-root">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="26000"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="overview-scene">
            <objects>
                <viewController title="Overview" id="overview-controller" customClass="MainViewController" customModule="FinTrack" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="overview-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <viewLayoutGuide key="safeArea" id="overview-safe"/>
                        <color key="backgroundColor" systemColor="systemGroupedBackgroundColor"/>
                    </view>
                    <navigationItem key="navigationItem" title="Overview" id="overview-nav-item"/>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="overview-first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <scene sceneID="overview-nav-scene">
            <objects>
                <navigationController id="overview-nav" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="Overview" image="house" catalog="system" selectedImage="house.fill" id="overview-tab"/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="overview-bar"/>
                    <connections>
                        <segue destination="overview-controller" kind="relationship" relationship="rootViewController" id="overview-root-segue"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="overview-nav-first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <scene sceneID="activity-scene">
            <objects>
                <viewController title="Activity" id="activity-controller" customClass="StatsViewController" customModule="FinTrack" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="activity-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <viewLayoutGuide key="safeArea" id="activity-safe"/>
                        <color key="backgroundColor" systemColor="systemGroupedBackgroundColor"/>
                    </view>
                    <navigationItem key="navigationItem" title="Activity" id="activity-nav-item"/>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="activity-first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <scene sceneID="activity-nav-scene">
            <objects>
                <navigationController id="activity-nav" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="Activity" image="list.bullet.rectangle" catalog="system" selectedImage="list.bullet.rectangle.fill" id="activity-tab"/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="activity-bar"/>
                    <connections>
                        <segue destination="activity-controller" kind="relationship" relationship="rootViewController" id="activity-root-segue"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="activity-nav-first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <scene sceneID="settings-scene">
            <objects>
                <tableViewController title="Settings" style="insetGrouped" id="settings-controller" customClass="SettingsViewController" customModule="FinTrack" customModuleProvider="target" sceneMemberID="viewController">
                    <tableView key="view" clipsSubviews="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" dataMode="prototypes" style="insetGrouped" separatorStyle="default" rowHeight="44" estimatedRowHeight="-1" sectionHeaderHeight="18" estimatedSectionHeaderHeight="-1" sectionFooterHeight="18" estimatedSectionFooterHeight="-1" id="settings-table">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" systemColor="systemGroupedBackgroundColor"/>
                        <connections>
                            <outlet property="dataSource" destination="settings-controller" id="settings-data-source"/>
                            <outlet property="delegate" destination="settings-controller" id="settings-delegate"/>
                        </connections>
                    </tableView>
                    <navigationItem key="navigationItem" title="Settings" id="settings-nav-item"/>
                </tableViewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="settings-first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <scene sceneID="settings-nav-scene">
            <objects>
                <navigationController id="settings-nav" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="Settings" image="gearshape" catalog="system" selectedImage="gearshape.fill" id="settings-tab"/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="settings-bar"/>
                    <connections>
                        <segue destination="settings-controller" kind="relationship" relationship="rootViewController" id="settings-root-segue"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="settings-nav-first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <scene sceneID="tab-scene">
            <objects>
                <tabBarController id="tab-root" sceneMemberID="viewController">
                    <tabBar key="tabBar" contentMode="scaleToFill" id="tab-bar"/>
                    <connections>
                        <segue destination="overview-nav" kind="relationship" relationship="viewControllers" id="tab-overview-segue"/>
                        <segue destination="activity-nav" kind="relationship" relationship="viewControllers" id="tab-activity-segue"/>
