root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.swift]
indent_style = space
indent_size = 4

[*.pbxproj]
indent_style = tab

[*.storyboard]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
